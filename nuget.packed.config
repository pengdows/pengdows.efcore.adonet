<?xml version="1.0" encoding="utf-8"?>
<!-- Used only by UsePackedCore=true: builds a plugin against the core packed into artifacts/packages, as an outside plugin does. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="packed-core" value="artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="packed-core">
      <package pattern="pengdows.efcore.adonet" />
    </packageSource>
  </packageSourceMapping>
</configuration>
