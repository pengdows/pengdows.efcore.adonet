<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EF Core's own SQL Server functional tests (dotnet/efcore v10.0.11, MIT), run against the AdoNet SQL Server plugin.
    Test files are copied unchanged; files under TestUtilities marked "pengdows:" bind the plugin instead of
    Microsoft.EntityFrameworkCore.SqlServer.
  -->
  <Import Project="..\FunctionalTests.props" />

  <ItemGroup>
    <Using Include="pengdows.efcore.adonet.sqlserver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\pengdows.efcore.adonet.sqlserver\pengdows.efcore.adonet.sqlserver.csproj" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

</Project>
