<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Provider-agnostic EF Core relational provider built on DbProviderFactory/DbDataSource and a pluggable SQL dialect.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 is suppressed for the members not yet documented; docs/PUBLIC_API.md lists the debt. Every other warning is an error. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="pengdows.efcore.adonet.Tests" />
    <InternalsVisibleTo Include="pengdows.efcore.adonet.Specification.Tests" />
</ItemGroup>
</Project>
