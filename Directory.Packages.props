<Project>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.31" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="DuckDB.NET.Data" Version="1.5.6.1" />
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
    <PackageVersion Include="pengdows.flatfile" Version="0.2.1-preview.19" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
    <PackageVersion Include="NetTopologySuite.IO.SqlServerBytes" Version="2.1.0" />
    <PackageVersion Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
    <PackageVersion Include="MySql.Data" Version="26.10.0" />
    <!-- Test-only comparison lane; Oracle's provider is never shipped by pengdows. -->
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="pengdows.crud.fakeDb" Version="2.0.6-rc1" />
    <!-- Test-only: caps the connections a run opens against a server with a fixed connection limit. -->
    <PackageVersion Include="pengdows.stormgate" Version="2.0.6" />
    <PackageVersion Include="pengdows.stormgate.EntityFrameworkCore" Version="2.0.6" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MariaDb" Version="4.16.0" />
    <!-- Pins the vulnerable 9.0.x pulled in transitively by Microsoft.Data.SqlClient. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
